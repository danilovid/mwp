# База SQLite (путь относительно корня проекта)
DATABASE_URL="file:./data/mwp.db"

# Папка для загруженных фото товаров
UPLOAD_DIR="./data/uploads"

# Секрет для подписи сессии админки (длинная случайная строка)
SESSION_SECRET="change-me-to-a-long-random-string"

# Первый админ (создаётся командой npm run seed, если админов ещё нет)
ADMIN_LOGIN="admin"
ADMIN_PASSWORD="change-me"

# Адрес сайта (для ссылок в письмах и метатегов)
SITE_URL="https://mwphockey.ru"

# Почта для отправки заявок (SMTP)
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
