# /etc/nginx/sites-available/mwp  →  ln -s ../sites-available/mwp /etc/nginx/sites-enabled/
# HTTPS добавит certbot: sudo certbot --nginx -d mwphockey.ru -d www.mwphockey.ru

server {
    listen 80;
    server_name www.mwphockey.ru;
    return 301 https://mwphockey.ru$request_uri;
}

server {
    listen 80;
    server_name mwphockey.ru;

    # загрузка фото товаров в админке
    client_max_body_size 25m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
